Name: eebpf
Version: @VERSION@
Release: 1%{?dist}
Summary: eBPF system anomaly observation and root cause analysis tool

License: GPL-2.0
URL: https://github.com/X2002w/ebpf
Source0: %{name}-%{version}.tar.gz

BuildRequires: clang, libbpf-devel, elfutils-libelf-devel, zlib-devel

%description
eebpf is a lightweight system observability tool based on eBPF
(libbpf + CO-RE). It covers 5 anomaly scenarios: CPU, I/O, memory,
lock contention, and syscall hotspots. Outputs structured Markdown
diagnosis reports and JSON data. Requires Linux kernel 6.6+ with
CONFIG_DEBUG_INFO_BTF.

%build
make

%install
make install-bin install-conf install-ai DESTDIR=%{buildroot} PREFIX=/usr

%files
%{_bindir}/eebpf
%{_bindir}/eebpf-ai
%config(noreplace) %{_sysconfdir}/eebpf.conf
%{_datadir}/eebpf/

%changelog
* @DATE@ Li Yan <15008695828@163.com> - @VERSION@-1
- Release @VERSION@
